{
  "version": 8,
  "name": "MapTiler Basic (Local)",
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "world": {
      "type": "vector",
      "url": "/world"
    },
    "local": {
      "type": "vector",
      "url": "/bahia-blanca"
    },
    "earth": {
      "type": "geojson",
      "data": "/land.geojson"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#ece6d9"
      }
    },
    {
      "id": "earth-land",
      "type": "fill",
      "source": "earth",
      "paint": {
        "fill-color": "#f4f3f0"
      }
    },
    {
      "id": "world-water",
      "type": "fill",
      "source": "world",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a5c9eb"
      }
    },
    {
      "id": "world-waterway",
      "type": "line",
      "source": "world",
      "source-layer": "waterway",
      "minzoom": 8,
      "paint": {
        "line-color": "#a5c9eb",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8,
          0.5,
          14,
          3
        ]
      }
    },
    {
      "id": "world-landcover",
      "type": "fill",
      "source": "world",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#c8e3b3",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "world-park",
      "type": "fill",
      "source": "world",
      "source-layer": "park",
      "minzoom": 8,
      "paint": {
        "fill-color": "#c8e3b3",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "world-landuse",
      "type": "fill",
      "source": "world",
      "source-layer": "landuse",
      "minzoom": 10,
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "residential",
          "#e0dbcd",
          "commercial",
          "#dcd7c9",
          "industrial",
          "#d8d2c4",
          "military",
          "#d0caba",
          "#f4f3f0"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "world-boundary-country",
      "type": "line",
      "source": "world",
      "source-layer": "boundary",
      "filter": [
        "==",
        ["get", "admin_level"],
        2
      ],
      "paint": {
        "line-color": "#9e9e9e",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          2,
          0.5,
          8,
          1.5
        ],
        "line-dasharray": [
          2,
          1
        ]
      }
    },
    {
      "id": "world-boundary-state",
      "type": "line",
      "source": "world",
      "source-layer": "boundary",
      "filter": [
        "==",
        ["get", "admin_level"],
        4
      ],
      "minzoom": 4,
      "paint": {
        "line-color": "#bdbdbd",
        "line-width": 0.8,
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "world-road-service",
      "type": "line",
      "source": "world",
      "source-layer": "transportation",
      "filter": [
        "in",
        ["get", "class"],
        [
          "literal",
          [
            "service",
            "track",
            "path",
            "footway"
          ]
        ]
      ],
      "minzoom": 14,
      "paint": {
        "line-color": "#e5e7eb",
        "line-width": 1
      }
    },
    {
      "id": "world-road-minor",
      "type": "line",
      "source": "world",
      "source-layer": "transportation",
      "filter": [
        "in",
        ["get", "class"],
        [
          "literal",
          [
            "minor",
            "residential",
            "unclassified"
          ]
        ]
      ],
      "minzoom": 13,
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          13,
          1,
          18,
          5
        ]
      }
    },
    {
      "id": "world-road-secondary",
      "type": "line",
      "source": "world",
      "source-layer": "transportation",
      "filter": [
        "in",
        ["get", "class"],
        [
          "literal",
          [
            "secondary",
            "tertiary"
          ]
        ]
      ],
      "minzoom": 10,
      "paint": {
        "line-color": "#fef08a",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10,
          1,
          18,
          7
        ]
      }
    },
    {
      "id": "world-road-primary",
      "type": "line",
      "source": "world",
      "source-layer": "transportation",
      "filter": [
        "in",
        ["get", "class"],
        [
          "literal",
          [
            "primary",
            "trunk"
          ]
        ]
      ],
      "minzoom": 8,
      "paint": {
        "line-color": "#fcd34d",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8,
          1,
          18,
          10
        ]
      }
    },
    {
      "id": "world-road-motorway",
      "type": "line",
      "source": "world",
      "source-layer": "transportation",
      "filter": [
        "==",
        ["get", "class"],
        "motorway"
      ],
      "minzoom": 6,
      "paint": {
        "line-color": "#fb923c",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6,
          1,
          18,
          12
        ]
      }
    },
    {
      "id": "world-building",
      "type": "fill-extrusion",
      "source": "world",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-extrusion-color": "#e2e8f0",
        "fill-extrusion-height": [
          "coalesce",
          ["get", "render_height"],
          ["get", "height"],
          12
        ],
        "fill-extrusion-base": [
          "coalesce",
          ["get", "render_min_height"],
          ["get", "min_height"],
          0
        ],
        "fill-extrusion-opacity": 0.6
      }
    },
    {
      "id": "world-road-label",
      "type": "symbol",
      "source": "world",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "symbol-placement": "line",
        "text-max-angle": 30
      },
      "paint": {
        "text-color": "#4b5563",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "world-place-country",
      "type": "symbol",
      "source": "world",
      "source-layer": "place",
      "filter": [
        "==",
        ["get", "class"],
        "country"
      ],
      "maxzoom": 8,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          2,
          10,
          6,
          14
        ],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#1f2937",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    },
    {
      "id": "world-place-city",
      "type": "symbol",
      "source": "world",
      "source-layer": "place",
      "filter": [
        "in",
        ["get", "class"],
        [
          "literal",
          [
            "city",
            "town"
          ]
        ]
      ],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6,
          10,
          14,
          16
        ],
        "icon-allow-overlap": false,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#374151",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    },
    {
      "id": "world-place-suburb",
      "type": "symbol",
      "source": "world",
      "source-layer": "place",
      "filter": [
        "in",
        ["get", "class"],
        [
          "literal",
          [
            "suburb",
            "neighbourhood",
            "quarter",
            "village"
          ]
        ]
      ],
      "minzoom": 12,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11
      },
      "paint": {
        "text-color": "#4b5563",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "local-building-detail",
      "type": "fill-extrusion",
      "source": "local",
      "source-layer": "building",
      "minzoom": 15,
      "paint": {
        "fill-extrusion-color": "#cbd5e1",
        "fill-extrusion-height": [
          "coalesce",
          ["get", "render_height"],
          ["get", "height"],
          15
        ],
        "fill-extrusion-base": [
          "coalesce",
          ["get", "render_min_height"],
          ["get", "min_height"],
          0
        ],
        "fill-extrusion-opacity": 0.7
      }
    }
  ]
}
