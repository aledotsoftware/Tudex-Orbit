{
  "version": 8,
  "name": "GeoCore Cyber-Nature",
  "metadata": {
    "geocore:version": "1.0.0",
    "geocore:author": "GeoCore Architect"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "http://localhost:3000/bahia-blanca"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#040712"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#081235",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "landuse_park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "park"],
      "paint": {
        "fill-color": "#064E3B",
        "fill-opacity": 0.4
      }
    },
    {
      "id": "road_minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "minor"],
      "paint": {
        "line-color": "#1E293B",
        "line-width": 1,
        "line-opacity": 0.5
      }
    },
    {
      "id": "road_main",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "primary", "secondary", "tertiary"],
      "paint": {
        "line-color": "#00F2FF",
        "line-width": 2,
        "line-blur": 1
      }
    },
    {
      "id": "road_highway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "paint": {
        "line-color": "#FF007F",
        "line-width": 3,
        "line-blur": 1,
        "line-opacity": 0.9
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "fill-color": "rgba(255, 255, 255, 0.05)",
        "fill-outline-color": "rgba(100, 255, 218, 0.2)"
      }
    },
    {
      "id": "place_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "layout": {
        "text-field": "{name}",
        "text-size": 14
      },
      "paint": {
        "text-color": "#FFFFFF",
        "text-halo-color": "#FF007F",
        "text-halo-width": 1
      }
    }
  ]
}
